# Dependencias de Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de entorno y configuración local
.env
.env.local
.env.*.local

# Builds de producción y carpetas de salida
dist/
build/
.next/
out/
.DS_Store

# 1. Ignorar todo en la raíz del proyecto por defecto
/*

# 2. Permitir explícitamente solo las carpetas y archivos que deseas mantener
!/api/
!/vinedopos/
!/database/
!/README.md
!/.gitignore

# 3. Ignorar siempre node_modules y builds dentro de las carpetas permitidas
**/node_modules/
**/build/
**/dist/

# 4. Ignorar archivos de entorno dentro de cualquier subcarpeta
**/.env
**/.env.*

# 5. Configuracion local y scripts de diagnostico con credenciales
api/config.json
api/check_*.js
api/request.http
api/crear_comanda_run.js